{
  "name": "dsh-plugin-upgrader",
  "version": "1.4.3",
  "description": "One-click upgrades, version history and rollback for plugins on the DeepSeek Harness Plugins page",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager",
    "version-manager"
  ],
  "license": "MIT",
  "author": "zuwenyin",
  "homepage": "https://github.com/zuwenyin/dsh-plugin-upgrader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuwenyin/dsh-plugin-upgrader.git"
  },
  "bugs": {
    "url": "https://github.com/zuwenyin/dsh-plugin-upgrader/issues"
  },
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.map",
    "locale/*.json",
    "assets/icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test",
    "check:pack": "node scripts/verify-pack.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && node scripts/build.mjs && node --test && node scripts/verify-pack.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-plugin-manager": "^0.2.1-rc.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
